:root {
  --header-offset: 100px;
}

* {
  box-sizing: border-box;
}

html {
  scroll-padding-top: calc(var(--header-offset) + 1px);
}

body {
  margin: 0;
  padding-top: var(--header-offset);
  font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  background: #f1f5f9;
  color: #102a43;
  line-height: 1.7;
  min-height: 100vh;
}
